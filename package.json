{
  "name": "sg-it-job-search",
  "version": "1.0.0",
  "description": "Singapore IT job search CLI with API-first fetching, Playwright fallback, and SQLite tracking.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
